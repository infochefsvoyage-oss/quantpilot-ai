{
  "name": "RiskSettings",
  "type": "object",
  "properties": {
    "risk_level": {
      "type": "string",
      "enum": [
        "LEVEL_1",
        "LEVEL_2",
        "LEVEL_3"
      ],
      "default": "LEVEL_2"
    },
    "risk_per_trade": {
      "type": "number",
      "default": 0.5
    },
    "max_open_positions": {
      "type": "number",
      "default": 1
    },
    "portfolio_exposure_cap": {
      "type": "number",
      "default": 10
    },
    "daily_loss_limit": {
      "type": "number",
      "default": 1.5
    },
    "weekly_loss_limit": {
      "type": "number",
      "default": 4
    },
    "max_drawdown_pause": {
      "type": "number",
      "default": 6
    },
    "capital_priority": {
      "type": "string",
      "default": "CAPITAL_PRESERVATION_FIRST"
    },
    "high_leverage_mode": {
      "type": "string",
      "enum": [
        "ENABLED",
        "DISABLED"
      ],
      "default": "DISABLED"
    },
    "daily_target": {
      "type": "number",
      "default": 2
    },
    "consecutive_loss_halving": {
      "type": "number",
      "default": 2
    },
    "tp1_pct": {
      "type": "number",
      "default": 40
    },
    "tp2_pct": {
      "type": "number",
      "default": 30
    },
    "tp3_pct": {
      "type": "number",
      "default": 30
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "risk_level"
  ]
}