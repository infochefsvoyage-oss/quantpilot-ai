{
  "name": "ArbOpportunity",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string"
    },
    "buy_exchange": {
      "type": "string",
      "enum": [
        "BINANCE",
        "MEXC",
        "BYBIT",
        "OKX"
      ]
    },
    "sell_exchange": {
      "type": "string",
      "enum": [
        "BINANCE",
        "MEXC",
        "BYBIT",
        "OKX"
      ]
    },
    "buy_price": {
      "type": "number"
    },
    "sell_price": {
      "type": "number"
    },
    "raw_spread_percent": {
      "type": "number"
    },
    "taker_fee_percent": {
      "type": "number"
    },
    "estimated_slippage_percent": {
      "type": "number"
    },
    "funding_cost_percent": {
      "type": "number"
    },
    "adverse_selection_cost_percent": {
      "type": "number"
    },
    "inventory_imbalance_cost_percent": {
      "type": "number"
    },
    "data_health": {
      "type": "string",
      "enum": [
        "HEALTHY",
        "DEGRADED",
        "FAILED",
        "UNKNOWN"
      ],
      "default": "UNKNOWN"
    },
    "feed_health": {
      "type": "string",
      "enum": [
        "HEALTHY",
        "DEGRADED",
        "HTTP_500",
        "HTTP_502",
        "HTTP_403",
        "TIMEOUT",
        "UNKNOWN"
      ],
      "default": "UNKNOWN"
    },
    "http_status": {
      "type": "number"
    },
    "freshness_valid": {
      "type": "boolean",
      "default": false
    },
    "latency_ms": {
      "type": "number"
    },
    "clock_sync_valid": {
      "type": "boolean",
      "default": false
    },
    "orderbook_slippage_valid": {
      "type": "boolean",
      "default": false
    },
    "adverse_selection_gate": {
      "type": "string",
      "enum": [
        "PASS",
        "REJECT",
        "UNKNOWN"
      ],
      "default": "UNKNOWN"
    },
    "inventory_gate": {
      "type": "string",
      "enum": [
        "PASS",
        "REJECT",
        "UNKNOWN"
      ],
      "default": "UNKNOWN"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "LIVE_CEX",
        "RESEARCH_DEX",
        "UNKNOWN"
      ],
      "default": "UNKNOWN"
    },
    "theoretical_net_profit": {
      "type": "number"
    },
    "realized_net_profit": {
      "type": "number"
    },
    "capture_eligible": {
      "type": "boolean",
      "default": false
    },
    "paper_execution_status": {
      "type": "string",
      "enum": [
        "NOT_STARTED",
        "COMPLETED",
        "FAILED",
        "BLOCKED"
      ],
      "default": "BLOCKED"
    },
    "dex_execution_mode": {
      "type": "string",
      "enum": [
        "NOT_APPLICABLE",
        "RESEARCH_ONLY"
      ],
      "default": "NOT_APPLICABLE"
    },
    "net_profit_percent": {
      "type": "number"
    },
    "market_regime": {
      "type": "string",
      "enum": [
        "CALM",
        "VOLATILE",
        "TRENDING",
        "ILLIQUID",
        "EXTREME"
      ]
    },
    "is_profitable_after_costs": {
      "type": "boolean",
      "default": false
    },
    "telegram_alert_sent": {
      "type": "boolean",
      "default": false
    },
    "governance_approved": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "DETECTED",
        "ALERTED",
        "GOVERNANCE_PENDING",
        "APPROVED",
        "EXECUTED",
        "PAPER_COMPLETED",
        "EXPIRED",
        "REJECTED"
      ],
      "default": "DETECTED"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "symbol",
    "buy_exchange",
    "sell_exchange",
    "buy_price",
    "sell_price",
    "market_regime",
    "status"
  ]
}