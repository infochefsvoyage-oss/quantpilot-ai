{
  "name": "ExchangeConnection",
  "type": "object",
  "properties": {
    "label": {
      "type": "string"
    },
    "exchange": {
      "type": "string",
      "enum": [
        "BINANCE",
        "MEXC"
      ]
    },
    "phase": {
      "type": "string",
      "enum": [
        "DISABLED",
        "TESTNET_PAPER",
        "SHADOW",
        "LIVE"
      ],
      "default": "DISABLED"
    },
    "scan_enabled": {
      "type": "boolean",
      "default": true
    },
    "paper_enabled": {
      "type": "boolean",
      "default": false
    },
    "shadow_enabled": {
      "type": "boolean",
      "default": false
    },
    "live_enabled": {
      "type": "boolean",
      "default": false
    },
    "api_key_id": {
      "type": "string"
    },
    "api_key_secret_encrypted": {
      "type": "string"
    },
    "last_sync": {
      "type": "string",
      "format": "date-time"
    },
    "rate_limit_status": {
      "type": "string",
      "enum": [
        "OK",
        "THROTTLED",
        "BLOCKED"
      ],
      "default": "OK"
    },
    "circuit_breaker_active": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "label",
    "exchange",
    "phase"
  ]
}